# Copy to .env (git-ignored) and fill in only what you need.
# Zkopíruj jako .env (je v .gitignore) a vyplň jen to, co potřebuješ.
# NIKDY necommituj .env ani secrets/ — NEVER commit .env or secrets/.

# --- paths -------------------------------------------------------------------
# Report root of the existing pipeline (build_site_v2.py, data/captures.jsonl, screenshots/)
ACR_REPORT_ROOT=/workspace/acr-map/report
# Where storage_state files live (default: ./secrets, chmod 700)
# ACR_SECRETS_DIR=./secrets
# Run output (default: ./out)
# ACR_OUT_DIR=./out

# --- browser / real-user emulation -------------------------------------------
ACR_HEADLESS=1
# chromium = Playwright Chromium in new headless mode (default)
# chrome   = installed Google Chrome;  empty = chromium-headless-shell
ACR_BROWSER_CHANNEL=chromium
# ACR_BROWSER_EXECUTABLE=/usr/bin/google-chrome
ACR_VIEWPORT=1440x900
ACR_LOCALE=cs-CZ
ACR_TIMEZONE=Europe/Prague
# Leave empty → realistic desktop Chrome UA with the same major version as the browser
# ACR_USER_AGENT=
# Random pause between pages (seconds) — be polite, avoid rate limits
ACR_DELAY_MIN=2
ACR_DELAY_MAX=6
# Cookie banners: reject (non-essential) | accept | skip
ACR_CONSENT=reject
# ACR_PROXY=http://user:pass@host:port

# --- OPTIONAL credentials (only for `login --use-env-credentials`) -----------
# Prefer manual login or cookie import; credentials are never written to disk.
# ACR_FB_EMAIL=
# ACR_FB_PASSWORD=
# ACR_IG_USERNAME=
# ACR_IG_PASSWORD=
# ACR_X_USERNAME=
# ACR_X_PASSWORD=
# ACR_LINKEDIN_EMAIL=
# ACR_LINKEDIN_PASSWORD=

# --- OPTIONAL per-service storage_state override -----------------------------
# ACR_FACEBOOK_STORAGE_STATE=/secure/place/facebook.storage_state.json
# ACR_INSTAGRAM_STORAGE_STATE=
# ACR_X_STORAGE_STATE=
# ACR_LINKEDIN_STORAGE_STATE=
# ACR_YOUTUBE_STORAGE_STATE=
